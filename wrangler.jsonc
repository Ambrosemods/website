{
  // Must match the existing Worker: personalwebsite.jwambrose17.workers.dev
  "name": "personalwebsite",
  "compatibility_date": "2026-08-17",
  "build": {
    "command": "chmod a+x build.sh && ./build.sh"
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "jwambrose.com", "custom_domain": true },
    { "pattern": "www.jwambrose.com", "custom_domain": true }
  ]
}
