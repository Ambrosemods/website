{
  // Deploy the static site only. Do not manage DNS/custom domains from Wrangler —
  // jwambrose.com still has Squarespace records, and custom_domain fails with 100117.
  "name": "personalwebsite",
  "compatibility_date": "2026-08-17",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
